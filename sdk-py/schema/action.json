    {
      "$ref": "#/$defs/LendingWithdrawCollateralAction"
    },
    {
      "$ref": "#/$defs/LendingBorrowAction"
    },
    {
      "$ref": "#/$defs/LendingRepayAction"
    },
    {
      "$ref": "#/$defs/LendingLiquidateAction"
    },
    {
      "$ref": "#/$defs/BundleAction"
    },
    {
      "$ref": "#/$defs/RawTxAction"
    },
    {
      "$ref": "#/$defs/RawBundleAction"
    }
  ],
  "title": "Action",
  "$defs": {
    "NoopAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "noop"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "title": "NoopAction"
    },
    "SwapAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "swap"
        },
        "tokenIn": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amountIn": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "slippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenIn",
        "amountIn"
      ],
      "additionalProperties": false,
      "title": "SwapAction"
    },
    "MintLiquidityAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mintLiquidity"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "tickLower": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tickUpper": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "amountWethDesired": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "amountUsdcDesired": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "amountBaseDesired": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "amountQuoteDesired": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "slippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tickLower",
        "tickUpper",
        "amountWethDesired",
        "amountUsdcDesired"
      ],
      "additionalProperties": false,
      "title": "MintLiquidityAction"
    },
    "RemoveLiquidityAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "removeLiquidity"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "tokenId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "liquidity": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "amountWethMin": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "amountUsdcMin": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenId",
        "liquidity"
      ],
      "additionalProperties": false,
      "title": "RemoveLiquidityAction"
    },
    "CollectFeesAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "collectFees"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "tokenId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenId"
      ],
      "additionalProperties": false,
      "title": "CollectFeesAction"
    },
    "CreatePoolAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "createPool"
        },
        "tokenA": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "tokenB": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "fee": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Uniswap V3 fee in pips: 100, 500, 3000 or 10000"
        },
        "sqrtPriceX96": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "initial price as sqrt(token1/token0) * 2^96, computed against the sorted pair (the lower address is token0)"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenA",
        "tokenB",
        "fee",
        "sqrtPriceX96"
      ],
      "additionalProperties": false,
      "title": "CreatePoolAction"
    },
    "BalancerSwapAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "balancerSwap"
        },
        "tokenIn": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amountIn": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "slippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenIn",
        "amountIn"
      ],
      "additionalProperties": false,
      "title": "BalancerSwapAction"
    },
    "CurveSwapAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "curveSwap"
        },
        "tokenIn": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amountIn": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "slippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenIn",
        "amountIn"
      ],
      "additionalProperties": false,
      "title": "CurveSwapAction"
    },
    "StableSwapAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stableSwap"
        },
        "stable": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "tokenIn": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amountIn": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "slippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "stable",
        "tokenIn",
        "amountIn"
      ],
      "additionalProperties": false,
      "title": "StableSwapAction"
    },
    "GmxIncreaseAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gmxIncrease"
        },
        "isLong": {
          "type": "boolean"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "collateral": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "collateralAmount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "sizeDeltaUsd": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "acceptablePrice": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "isLong",
        "collateral",
        "collateralAmount",
        "sizeDeltaUsd"
      ],
      "additionalProperties": false,
      "title": "GmxIncreaseAction"
    },
    "GmxDecreaseAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gmxDecrease"
        },
        "isLong": {
          "type": "boolean"
        },
        "base": {
          "description": "market selector: the base asset of the base/USDC market to trade (e.g. \"WBTC\"). Omit for the default WETH/USDC market. NOT the input token — use tokenIn for that (tokenIn is the base symbol to sell, or \"USDC\" to buy).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "collateral": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "collateralDeltaAmount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "sizeDeltaUsd": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "acceptablePrice": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "isLong",
        "collateral",
        "collateralDeltaAmount",
        "sizeDeltaUsd"
      ],
      "additionalProperties": false,
      "title": "GmxDecreaseAction"
    },
    "AaveSupplyAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "aaveSupply"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "asset",
        "amount"
      ],
      "additionalProperties": false,
      "title": "AaveSupplyAction"
    },
    "AaveWithdrawAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "aaveWithdraw"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "string",
              "const": "max"
            }
          ]
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "asset",
        "amount"
      ],
      "additionalProperties": false,
      "title": "AaveWithdrawAction"
    },
    "AaveBorrowAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "aaveBorrow"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "asset",
        "amount"
      ],
      "additionalProperties": false,
      "title": "AaveBorrowAction"
    },
    "AaveRepayAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "aaveRepay"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9]+$"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "string",
              "const": "max"
            }
          ]
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "asset",
        "amount"
      ],
      "additionalProperties": false,
      "title": "AaveRepayAction"
    },
    "LstDepositAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lstDeposit"
        },
        "amountWethWei": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "WETH to stake (wei). Mints LST at the vault's current redemption rate."
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "amountWethWei"
      ],
      "additionalProperties": false,
      "title": "LstDepositAction"
    },
    "LstSwapAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lstSwap"
        },
        "tokenIn": {
          "type": "string",
          "enum": [
            "WETH",
            "LST"
          ],
          "description": "the token you are sending: \"WETH\" buys LST from the secondary market, \"LST\" sells into it (the instant exit, at the pool's discount)."
        },
        "amountIn": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "wei of tokenIn (both are 18-decimal)"
        },
        "slippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "tokenIn",
        "amountIn"
      ],
      "additionalProperties": false,
      "title": "LstSwapAction"
    },
    "LstRequestWithdrawAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lstRequestWithdraw"
        },
        "amountLstWei": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "LST shares to queue for redemption at par (wei). Claimable after withdrawalDelayBlocks; this is the slow, full-value exit."
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "amountLstWei"
      ],
      "additionalProperties": false,
      "title": "LstRequestWithdrawAction"
    },
    "LstClaimWithdrawAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lstClaimWithdraw"
        },
        "requestId": {
          "description": "a specific queued request id. Omit to claim every request that has finalized.",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "title": "LstClaimWithdrawAction"
    },
    "LiquityOpenTroveAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "liquityOpenTrove"
        },
        "collateralWethWei": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "WETH to unwrap and post as collateral (wei). It also has to leave enough native ETH behind to pay for gas."
        },
        "debtEusdWei": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "eUSD to draw (wei). Booked debt is this plus the borrowing fee plus 200 eUSD of gas compensation, and the total must clear MIN_NET_DEBT (1,800 eUSD)."
        },
        "maxFeeBps": {
          "description": "slippage bound on the protocol fee, in bps. Both fee curves rise with use, so a bound that is too tight reverts. Default 500 (5%).",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "maxPriorityFeePerGasWei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "type",
        "collateralWethWei",
        "debtEusdWei"
      ],
      "additionalProperties": false,
      "title": "LiquityOpenTroveAction"
    },
    "LiquityAdjustTroveAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "liquityAdjustTrove"
        },
        "addCollateralWethWei": {
          "description": "WETH to unwrap and add as collateral (wei).",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "withdrawCollateralWei": {
          "description": "collateral to take back out, paid in native ETH (wei).",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "debtChangeEusdWei": {
          "description": "eUSD to draw or repay (wei); set isDebtIncrease to say which.",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "isDebtIncrease": {
          "description": "true draws more eUSD, false repays. Required with a debt change.",
          "type": "boolean"
        },
