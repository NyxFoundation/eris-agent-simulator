    {
      "$ref": "#/$defs/LstClaimWithdrawAction"
    },
    {
      "$ref": "#/$defs/LiquityOpenTroveAction"
    },
    {
      "$ref": "#/$defs/LiquityAdjustTroveAction"
    },
    {
      "$ref": "#/$defs/LiquityCloseTroveAction"
    },
    {
      "$ref": "#/$defs/LiquityRedeemAction"
    },
    {
      "$ref": "#/$defs/LiquityProvideToSPAction"
    },
    {
      "$ref": "#/$defs/LiquityWithdrawFromSPAction"
    },
    {
      "$ref": "#/$defs/LiquityLiquidateAction"
    },
    {
      "$ref": "#/$defs/LiquitySwapEusdAction"
