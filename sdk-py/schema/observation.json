        },
        "curve": {
          "$ref": "#/definitions/AmmObservation"
        },
        "gmx": {
          "$ref": "#/definitions/GmxObservation"
        },
        "aave": {
          "$ref": "#/definitions/AaveObservation"
        },
        "lst": {
