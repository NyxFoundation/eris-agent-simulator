# Copy to ~/.config/ascon-faucet.env (chmod 600). Never commit the real file.

# Discord: the bot's token, the server, the participant role, and (optional) a private ops channel
DISCORD_TOKEN=
DISCORD_GUILD_ID=
PARTICIPANT_ROLE_ID=
OPS_CHANNEL_ID=

# The registration spreadsheet, read-only through a service account the sheet is shared with
GOOGLE_SA_KEY_FILE=/home/<user>/.config/ascon-faucet-sa.json
SHEET_ID=
SHEET_RANGE=フォームの回答 1!A:Z
SHEET_USERNAME_HEADER=Discord ユーザー名 / Discord username
# Optional: count a row only when this column holds exactly SHEET_APPROVED_VALUE (e.g. a checkbox)
SHEET_APPROVED_HEADER=
SHEET_APPROVED_VALUE=TRUE

# Defaults shown; change only if the box differs
# REPO_DIR=/home/<user>/workspace/eris-agent-simulator
# RPC_URL=http://127.0.0.1:8545
# STATE_DIR=/home/<user>/.local/state/ascon-faucet
# SYNC_MINUTES=10
# MAX_PER_HOUR=20
# SEGMENT_HOURS=24
# DASHBOARD_URL=https://ascon-dash.nyx.foundation

# 1 = check everything, write nothing, add no role (use for the first start)
DRY_RUN=1
