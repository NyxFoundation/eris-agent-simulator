# Official docker-compose/proxy/default.conf.template, kept to the port-80 server only
# (the 8080/8081 servers proxy the stats and visualizer services this compose drops).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
    listen       80;
    server_name  localhost;
    proxy_http_version 1.1;

    # The explorer is published without authentication (infra/cloudflared/config.yml) and reads the
    # node directly rather than through the RPC gateway. Two of Blockscout's endpoints forward a
    # caller's own JSON-RPC method to that node: /api/eth-rpc, and the etherscan-compatible
    # /api?module=proxy (eth_call, eth_sendRawTransaction, eth_getCode, eth_getStorageAt...). Left
    # open they are a second RPC entrance that none of the gateway's rules reach -- no X-ASCON-Key,
    # no method allowlist, no per-transaction gas cap, no fee rule, no rate limit. Refused here, in
    # front of the backend, because this file is the boundary that is actually published. Everything
    # else, /api/v2 included (read-only, served from the indexed database), is unchanged.
    location = /api/eth-rpc {
        return 403;
    }

    location ~ ^/(api(?!-docs$)|socket|sitemap.xml|auth/auth0|auth/auth0/callback|auth/logout) {
        if ($arg_module = "proxy") {
            return 403;
        }
        proxy_pass            ${BACK_PROXY_PASS};
        proxy_http_version    1.1;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_cache_bypass    $http_upgrade;
    }
    location / {
        proxy_pass            ${FRONT_PROXY_PASS};
        proxy_http_version    1.1;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_cache_bypass    $http_upgrade;
    }
}
