# Host paths the stack binds into its containers. Copy to .env and adjust.
#   cp .env.example .env
# The bootstrap (infra/provision/bootstrap.sh) writes this file for you.
#
# These used to be hard-coded to /home/gohan/... which tied the whole stack to one box and one
# username. Compose fails loudly (not silently with an empty path) if either is unset.

# Checkout of eris-agent-simulator.
ERIS_ROOT=/home/gohan/workspace/eris-agent-simulator

# Where promtail/Loki read logs from and the RPC gateways write theirs.
ASCON_LOGS=/home/gohan/ascon-logs

# The directory holding rpc-keys.json -- the per-participant RPC keys the gateway authenticates
# on (sha256 digests only; the keys themselves live in <file>.secrets.csv on the operator's
# machine and are never deployed). Generate with infra/access/issue-key.sh. Mounting it makes
# X-ASCON-Key mandatory.
#
# A directory, not the file: a single-file bind mount pins its inode, so replacing the file leaves
# the container reading the old one and revocation silently stops working. Keep only the digest
# map in here.
ASCON_KEYS_DIR=/home/ascon/ascon-gateway-keys
