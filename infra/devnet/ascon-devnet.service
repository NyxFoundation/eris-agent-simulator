[Unit]
Description=ASCON practice devnet coordinator
Documentation=https://github.com/NyxFoundation/eris-agent-simulator/blob/main/infra/devnet/README.md
After=network-online.target
Wants=network-online.target

# A restart does not resume: `competitionId` is the process start time (core/src/realtime/
# coordinator.ts), so every start opens a NEW competition directory and the standings begin again.
# That is tolerable once. It is not tolerable in a loop, which would shard a week-long period into
# dozens of directories nobody can read. Three starts an hour, then the unit stays failed and the
# stall alert (infra/monitoring) says so in Slack.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/workspace/eris-agent-simulator

# `.env.local` is read in-process (core/src/cli/bootstrapEnv.ts) relative to WorkingDirectory, so
# ANVIL_RPC_URL / CHAIN_ID / TREASURY_PRIVATE_KEY stay there and never appear in this file.
# systemd gives no login shell, so PATH has to be stated. Both layouts are listed because this unit
# has to serve the NixOS box it was written on and the Ubuntu box it now runs on: `~/.foundry/bin`
# is where foundryup puts anvil/cast, the nix paths are inert on Ubuntu and vice versa.
# infra/provision/bootstrap.sh links this file unchanged into ~/.config/systemd/user/: every path in
# it is under %h, and it is a user unit on every box (issue #158).
Environment=PATH=%h/.foundry/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The chain is a container that may still be starting at boot. Waiting here rather than failing
# keeps the restart budget above for real faults.
ExecStartPre=%h/workspace/eris-agent-simulator/infra/devnet/wait-for-chain.sh

# The seed is the one run key that does not come from the config. config/practice.yaml is public, and
# the price walk, the flow and every event window are pure functions of the seed: with the committed
# `seed: 1` anyone can compute the block each crash lands on. `.env.practice` (gitignored, one line:
# ERIS_PRACTICE_SEED=<a number nobody has seen>) is read by systemd, not by the coordinator -- the
# value reaches the run as the `--seed` flag, which does override the file (core/src/runConfig.ts).
# No `-` prefix: a missing file fails the start, and so does an empty value (below). Falling back
# to the committed seed would be a period anyone can replay in advance, running as if nothing were
# wrong.
EnvironmentFile=%h/workspace/eris-agent-simulator/.env.practice
ExecStartPre=/bin/sh -c 'test -n "$$ERIS_PRACTICE_SEED" || { echo "ERIS_PRACTICE_SEED is empty in .env.practice: refusing to start the period on the committed seed" >&2; exit 1; }'
# The scenario key (ADR 0027), from the same file: ERIS_SCENARIO_KEY_FILE=<path to a key file from
# `npm run competition -- keygen`>. The coordinator reads it from the environment. Without it the
# period would be realized under the public key, so a missing or unreadable file fails the start.
ExecStartPre=/bin/sh -c 'test -n "$$ERIS_SCENARIO_KEY_FILE" && test -r "$$ERIS_SCENARIO_KEY_FILE" || { echo "ERIS_SCENARIO_KEY_FILE is missing or unreadable in .env.practice: refusing to start the period under the public scenario key" >&2; exit 1; }'
# The wallet secret (issue #189, core/src/walletKeys.ts), from the same file:
# ERIS_WALLET_SECRET_FILE=<path to a file from `npm run competition -- wallet-keygen`>. Every AUTO
# agent's key, every flow wallet's and every key handed to a participant is derived from it. Without
# it each start draws a new random secret: nothing leaks, but the resident agents and flow wallets
# move to new addresses and the keys participants were given stop working. So it fails the start.
ExecStartPre=/bin/sh -c 'test -n "$$ERIS_WALLET_SECRET_FILE" && test -r "$$ERIS_WALLET_SECRET_FILE" || { echo "ERIS_WALLET_SECRET_FILE is missing or unreadable in .env.practice: refusing to start the period on new wallets" >&2; exit 1; }'

# The config is the period. Every `run.*` key in it WINS over the environment (sdk/src/runConfig.ts),
# so overriding the block count or the report directory from here silently does nothing — copy the
# config and point at the copy instead. The seed is the exception above: a CLI flag, not the env.
ExecStart=/usr/bin/env npm run sim:realtime -- --config config/practice.yaml --seed ${ERIS_PRACTICE_SEED}

Restart=on-failure
RestartSec=30

# The coordinator installs no SIGTERM handler. A stop is abrupt: events.jsonl / blocks.csv /
# intervals.jsonl are append-only and survive, summary.json is not written. Stopping ends the period.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ascon-devnet

[Install]
WantedBy=default.target
