# infra/dashboard/sync.env -- what eris-dashboard-sync builds on this box (issue #211).
#
# Copy to sync.env (gitignored) next to this file, or let `sync-main.sh promote <ref>` write it.
# KEY=VALUE lines, ERIS_SYNC_* only; read by sync-main.sh itself, not by systemd. A variable already
# in the environment wins over this file.
#
# Exactly one of the two refs below, or neither:
#
#   ERIS_SYNC_REF            pinned to a tag or a commit sha. Refused unless it is an ancestor of
#                            origin/main. The mode for a live week. Moving it is a decision:
#                            `infra/dashboard/sync-main.sh promote v2026.10.02` (or a sha)
#   ERIS_SYNC_FOLLOW_BRANCH  follow a branch tip (`main`): every commit that lands there is built
#                            and its vite config executed on this box within five minutes. The
#                            pre-#211 behaviour, opt-in, and the tick logs it in capitals
#   (neither)                held at whatever HEAD is. Builds it if dist is stale, fetches nothing
ERIS_SYNC_REF=v2026.10.02
#ERIS_SYNC_FOLLOW_BRANCH=main

# Where the build runs. `container` (default): node:24-bookworm-slim, --network none, a clean
# export of the commit plus node_modules read-only, nothing else mounted -- no .env.local, no
# .env.practice, no keys, no runs/. `host`: the old in-place `npm run dashboard:build` as this user,
# with everything the user can read in reach; use it only when docker is unavailable, and know the
# tick logs it.
#ERIS_SYNC_BUILD=container
#ERIS_SYNC_BUILD_IMAGE=node:24-bookworm-slim
